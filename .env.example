# Configuração de Ambiente para Hostinger / Produção

# PORT: Porta dinâmica injetada automaticamente pela Hostinger (padrão: 3000)
PORT=3000

# NODE_ENV: Ambiente de execução ('production' ou 'development')
NODE_ENV=production

# (Opcional) URL de streaming Mux HLS (.m3u8), caso utilize CDN adaptativa externa
# VITE_HLS_STREAM_URL="https://stream.mux.com/SEU_VIDEO.m3u8"
